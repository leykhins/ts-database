# `npx convex dev` writes the real values into .env.local (gitignored) — this
# file just records what the app reads. The npm scripts pass
# `--dotenv .env.local` so Nuxt loads Convex's file rather than a separate .env;
# put any other app env vars in .env.local too.

# Written by `npx convex dev`. Either name works — the app prefers the first.
NUXT_PUBLIC_CONVEX_URL=
CONVEX_URL=https://your-deployment.convex.cloud

# Also written by `npx convex dev`; used by convex/auth.config.ts on the server.
CONVEX_DEPLOYMENT=dev:your-deployment
CONVEX_SITE_URL=https://your-deployment.convex.site

# Set on the deployment itself, not here:
#   npx @convex-dev/auth     — generates JWT_PRIVATE_KEY / JWKS
#   npx convex env set SITE_URL http://localhost:3000

# The password the sign-in screen's "Fill a test account" picker types for you.
# Use the same one passed to:
#   npx convex run users:seedTestAccounts '{"password":"…"}'
#
# READ THIS BEFORE SETTING IT ON A DEPLOYMENT. The value is inlined into the
# client bundle, so any environment where it is set has *open administrator
# credentials* — anyone with the URL can sign in and change or delete anything.
# That is deliberate here because every deployment holds fictional seed data. It
# must never be set on a deployment holding real resident records.
#
# Unset is the safe default and is genuinely absent, not merely hidden: the
# guard folds to false at build time and Rollup drops the component chunk —
# markup, usernames and password together. Verify with:
#   npm run build && grep -r test.admin .output/
NUXT_PUBLIC_DEMO_PASSWORD=

# On Vercel, NUXT_PUBLIC_CONVEX_URL has to be set for every environment the
# branch can build in — Production, Preview and Development are separate scopes,
# and a build that misses it ships a client pointed at nothing. `ssr: false`
# means the value is read at build time, so changing it needs a redeploy to
# take effect, not just a page reload.
