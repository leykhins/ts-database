{
  "name": "ts-database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TS Database \u2014 supportive & low-income housing operations dashboard (Nuxt 4 + Convex)",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "nuxt dev --dotenv .env.local",
    "dev:backend": "convex dev",
    "build": "nuxt build --dotenv .env.local",
    "generate": "nuxt generate --dotenv .env.local",
    "preview": "nuxt preview --dotenv .env.local",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "codegen": "convex codegen",
    "seed": "convex run seed:run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.44.0",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "convex-test": "^0.0.55",
    "shadcn-nuxt": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "esbuild@0.28.2": true,
    "vue-demi@0.14.10": true
  }
}
